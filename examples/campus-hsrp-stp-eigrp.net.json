{
  "$schema": "../schemas/network-model.schema.json",
  "modelVersion": 1,
  "meta": {
    "name": "Redundant campus: HSRP + Rapid PVST+ + EIGRP",
    "description": "Two 3560 distribution switches with per-VLAN HSRP (DS1 active for 10/99, DS2 for 20) and aligned STP root; 2960 access switches with dual uplinks (STP blocks one path per VLAN); LACP EtherChannel between distribution switches; EIGRP to the PAT edge router. Each distribution switch has a floating default route (AD 5) over VLAN 99 to the other one, to keep Internet access if its uplink fails.",
    "target": "packet-tracer",
    "level": "advanced",
    "language": "en"
  },
  "vlans": [
    {
      "id": 10,
      "name": "SALES",
      "subnet": "10.1.10.0/24",
      "gateway": "10.1.10.1",
      "purpose": "data"
    },
    {
      "id": 20,
      "name": "ENGINEERING",
      "subnet": "10.1.20.0/24",
      "gateway": "10.1.20.1",
      "purpose": "data"
    },
    {
      "id": 99,
      "name": "MGMT",
      "subnet": "10.1.99.0/24",
      "gateway": "10.1.99.1",
      "purpose": "management"
    },
    {
      "id": 999,
      "name": "NATIVE",
      "purpose": "native"
    }
  ],
  "devices": [
    {
      "id": "ISP",
      "type": "internet",
      "model": "2911",
      "role": "internet",
      "interfaces": [
        {
          "name": "GigabitEthernet0/0",
          "ip": "203.0.113.1/30"
        },
        {
          "name": "Loopback0",
          "ip": "8.8.8.8/32",
          "description": "Simulated Internet host"
        }
      ]
    },
    {
      "id": "EDGE",
      "type": "router",
      "vendor": "cisco",
      "model": "ISR4331",
      "role": "edge",
      "interfaces": [
        {
          "name": "GigabitEthernet0/0/0",
          "ip": "203.0.113.2/30",
          "nat": "outside"
        },
        {
          "name": "GigabitEthernet0/0/1",
          "ip": "10.0.1.1/30",
          "nat": "inside",
          "description": "To DS1"
        },
        {
          "name": "GigabitEthernet0/0/2",
          "ip": "10.0.2.1/30",
          "nat": "inside",
          "description": "To DS2"
        }
      ],
      "routing": {
        "static": [
          {
            "prefix": "0.0.0.0/0",
            "nextHop": "203.0.113.1"
          }
        ],
        "eigrp": {
          "as": 100,
          "routerId": "1.1.1.1",
          "networks": [
            "10.0.1.0/30",
            "10.0.2.0/30"
          ]
        }
      },
      "services": {
        "nat": {
          "insideSources": [
            "10.0.0.0/8"
          ],
          "overloadInterface": "GigabitEthernet0/0/0"
        }
      },
      "security": {
        "enableSecret": "class",
        "consolePassword": "cisco",
        "servicePasswordEncryption": true
      }
    },
    {
      "id": "DS1",
      "type": "l3switch",
      "vendor": "cisco",
      "model": "3560-24PS",
      "role": "distribution",
      "interfaces": [
        {
          "name": "GigabitEthernet0/1",
          "ip": "10.0.1.2/30",
          "description": "Routed to EDGE"
        },
        {
          "name": "FastEthernet0/1-2",
          "mode": "trunk",
          "nativeVlan": 999,
          "allowedVlans": [
            10,
            20,
            99,
            999
          ],
          "channelGroup": {
            "id": 1,
            "mode": "active"
          }
        },
        {
          "name": "Port-channel1",
          "mode": "trunk",
          "nativeVlan": 999,
          "allowedVlans": [
            10,
            20,
            99,
            999
          ],
          "description": "LACP to DS2"
        },
        {
          "name": "FastEthernet0/3",
          "mode": "trunk",
          "nativeVlan": 999,
          "allowedVlans": [
            10,
            20,
            99,
            999
          ],
          "description": "Uplink AS1"
        },
        {
          "name": "FastEthernet0/4",
          "mode": "trunk",
          "nativeVlan": 999,
          "allowedVlans": [
            10,
            20,
            99,
            999
          ],
          "description": "Uplink AS2"
        },
        {
          "name": "Vlan10",
          "ip": "10.1.10.2/24",
          "hsrp": {
            "group": 10,
            "ip": "10.1.10.1",
            "priority": 110,
            "preempt": true
          }
        },
        {
          "name": "Vlan20",
          "ip": "10.1.20.2/24",
          "hsrp": {
            "group": 20,
            "ip": "10.1.20.1",
            "priority": 90
          }
        },
        {
          "name": "Vlan99",
          "ip": "10.1.99.2/24",
          "hsrp": {
            "group": 99,
            "ip": "10.1.99.1",
            "priority": 110,
            "preempt": true
          }
        }
      ],
      "routing": {
        "ipRouting": true,
        "static": [
          {
            "prefix": "0.0.0.0/0",
            "nextHop": "10.0.1.1"
          },
          {
            "prefix": "0.0.0.0/0",
            "nextHop": "10.1.99.3",
            "ad": 5,
            "description": "Floating via DS2 if the uplink fails"
          }
        ],
        "eigrp": {
          "as": 100,
          "routerId": "2.2.2.2",
          "networks": [
            "10.0.1.0/30",
            "10.1.0.0/16"
          ],
          "passiveInterfaces": [
            "Vlan10",
            "Vlan20",
            "Vlan99"
          ]
        }
      },
      "stp": {
        "mode": "rapid-pvst",
        "rootPrimary": [
          10,
          99
        ],
        "rootSecondary": [
          20
        ]
      },
      "security": {
        "enableSecret": "class",
        "consolePassword": "cisco",
        "servicePasswordEncryption": true
      }
    },
    {
      "id": "DS2",
      "type": "l3switch",
