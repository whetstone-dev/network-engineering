{
  "$schema": "../schemas/network-model.schema.json",
  "modelVersion": 1,
  "meta": {
    "name": "PT lab: two sites with OSPF area 0, ROAS and DHCP",
    "description": "SITE-A and SITE-B joined by a serial link between two 2911 routers (HWIC-2T). Each site: 2960 switch with VLAN 10 USERS and VLAN 20 SERVERS, router-on-a-stick, DHCP on the router for USERS. OSPF area 0 between sites.",
    "target": "packet-tracer",
    "level": "intermediate",
    "language": "en"
  },
  "vlans": [
    {
      "id": 10,
      "name": "USERS",
      "purpose": "data",
      "description": "SITE-A 10.1.10.0/24 · SITE-B 10.2.10.0/24"
    },
    {
      "id": 20,
      "name": "SERVERS",
      "purpose": "servers",
      "description": "SITE-A 10.1.20.0/24 · SITE-B 10.2.20.0/24"
    },
    {
      "id": 99,
      "name": "MGMT",
      "purpose": "management",
      "description": "SITE-A 10.1.99.0/24 · SITE-B 10.2.99.0/24"
    },
    {
      "id": 999,
      "name": "NATIVE",
      "purpose": "native",
      "description": "Native VLAN without hosts"
    }
  ],
  "devices": [
    {
      "id": "R-SITE-A",
      "type": "router",
      "vendor": "cisco",
      "model": "2911",
      "role": "edge",
      "zone": "site-a",
      "interfaces": [
        {
          "name": "GigabitEthernet0/0",
          "description": "Trunk to SW-SITE-A"
        },
        {
          "name": "GigabitEthernet0/0.10",
          "vlan": 10,
          "ip": "10.1.10.1/24",
          "description": "Gateway USERS SITE-A"
        },
        {
          "name": "GigabitEthernet0/0.20",
          "vlan": 20,
          "ip": "10.1.20.1/24",
          "description": "Gateway SERVERS SITE-A"
        },
        {
          "name": "GigabitEthernet0/0.99",
          "vlan": 99,
          "ip": "10.1.99.1/24",
          "description": "Gateway MGMT SITE-A"
        },
        {
          "name": "Serial0/0/0",
          "ip": "10.0.0.1/30",
          "clockRate": 64000,
          "description": "WAN to R-SITE-B (DCE)"
        }
      ],
      "routing": {
        "ospf": {
          "processId": 1,
          "routerId": "1.1.1.1",
          "networks": [
            {
              "prefix": "10.0.0.0/30",
              "area": 0
            },
            {
              "prefix": "10.1.10.0/24",
              "area": 0
            },
            {
              "prefix": "10.1.20.0/24",
              "area": 0
            },
            {
              "prefix": "10.1.99.0/24",
              "area": 0
            }
          ],
          "passiveInterfaces": [
            "GigabitEthernet0/0.10",
            "GigabitEthernet0/0.20",
            "GigabitEthernet0/0.99"
          ]
        }
      },
      "services": {
        "dhcp": {
          "excluded": [
            {
              "from": "10.1.10.1",
              "to": "10.1.10.10"
            }
          ],
          "pools": [
            {
              "name": "USERS-A",
              "network": "10.1.10.0/24",
              "defaultRouter": "10.1.10.1",
              "dns": [
                "10.2.20.10"
              ]
            }
          ]
        }
      },
      "security": {
        "enableSecret": "class",
        "consolePassword": "cisco",
        "servicePasswordEncryption": true,
        "banner": "Authorized personnel only"
      }
    },
    {
      "id": "R-SITE-B",
      "type": "router",
      "vendor": "cisco",
      "model": "2911",
      "role": "edge",
      "zone": "site-b",
      "interfaces": [
        {
          "name": "GigabitEthernet0/0",
          "description": "Trunk to SW-SITE-B"
        },
        {
          "name": "GigabitEthernet0/0.10",
          "vlan": 10,
          "ip": "10.2.10.1/24",
          "description": "Gateway USERS SITE-B"
        },
        {
          "name": "GigabitEthernet0/0.20",
          "vlan": 20,
          "ip": "10.2.20.1/24",
          "description": "Gateway SERVERS SITE-B"
        },
        {
          "name": "GigabitEthernet0/0.99",
          "vlan": 99,
          "ip": "10.2.99.1/24",
          "description": "Gateway MGMT SITE-B"
        },
        {
          "name": "Serial0/0/0",
          "ip": "10.0.0.2/30",
          "description": "WAN to R-SITE-A (DTE)"
        }
      ],
      "routing": {
        "ospf": {
          "processId": 1,
          "routerId": "2.2.2.2",
          "networks": [
            {
              "prefix": "10.0.0.0/30",
              "area": 0
            },
            {
              "prefix": "10.2.10.0/24",
              "area": 0
            },
            {
              "prefix": "10.2.20.0/24",
              "area": 0
            },
            {
              "prefix": "10.2.99.0/24",
              "area": 0
            }
          ],
          "passiveInterfaces": [
            "GigabitEthernet0/0.10",
            "GigabitEthernet0/0.20",
            "GigabitEthernet0/0.99"
          ]
        }
      },
      "services": {
        "dhcp": {
          "excluded": [
            {
              "from": "10.2.10.1",
              "to": "10.2.10.10"
            }
          ],
          "pools": [
            {
              "name": "USERS-B",
              "network": "10.2.10.0/24",
              "defaultRouter": "10.2.10.1",
              "dns": [
                "10.2.20.10"
              ]
            }
          ]
        }
      },
      "security": {
        "enableSecret": "class",
        "consolePassword": "cisco",
        "servicePasswordEncryption": true,
        "banner": "Authorized personnel only"
      }
    },
    {
      "id": "SW-SITE-A",
      "type": "switch",
      "vendor": "cisco",
      "model": "2960-24TT",
      "role": "access",
      "zone": "site-a",
      "gateway": "10.1.99.1",
      "interfaces": [
        {
          "name": "GigabitEthernet0/1",
          "mode": "trunk",
          "nativeVlan": 999,
          "allowedVlans": [
            10,
            20,
            99,
            999
          ],
          "description": "Trunk to R-SITE-A"
        },
        {
          "name": "FastEthernet0/1-12",
          "mode": "access",
          "vlan": 10,
          "portfast": true
        },
        {
          "name": "FastEthernet0/13-20",
          "mode": "access",
          "vlan": 20,
          "portfast": true
        },
        {
          "name": "Vlan99",
          "ip": "10.1.99.11/24",
          "description": "Management"
        }
      ],
      "security": {
        "enableSecret": "class",
        "consolePassword": "cisco",
        "servicePasswordEncryption": true
      }
    },
    {
      "id": "SW-SITE-B",
      "type": "switch",
      "vendor": "cisco",
      "model": "2960-24TT",
      "role": "access",
      "zone": "site-b",
      "gateway": "10.2.99.1",
      "interfaces": [
        {
          "name": "GigabitEthernet0/1",
          "mode": "trunk",
          "nativeVlan": 999,
          "allowedVlans": [
            10,
            20,
            99,
            999
          ],
          "description": "Trunk to R-SITE-B"
        },
        {
          "name": "FastEthernet0/1-12",
          "mode": "access",
          "vlan": 10,
          "portfast": true
        },
        {
          "name": "FastEthernet0/13-20",
          "mode": "access",
          "vlan": 20,
          "portfast": true
        },
        {
          "name": "Vlan99",
          "ip": "10.2.99.11/24",
          "description": "Management"
        }
      ],
      "security": {
        "enableSecret": "class",
        "consolePassword": "cisco",
        "servicePasswordEncryption": true
      }
    },
    {
      "id": "PC-A1",
      "type": "pc",
      "model": "PC-PT",
      "zone": "site-a",
      "interfaces": [
        {
          "name": "FastEthernet0",
          "dhcp": true
        }
      ]
    },
    {
      "id": "PC-A2",
      "type": "pc",
      "model": "PC-PT",
      "zone": "site-a",
      "interfaces": [
        {
          "name": "FastEthernet0",
          "dhcp": true
        }
      ]
    },
    {
      "id": "SRV-A",
      "type": "server",
      "model": "Server-PT",
      "role": "server",
      "zone": "site-a",
      "gateway": "10.1.20.1",
      "interfaces": [
        {
          "name": "FastEthernet0",
          "ip": "10.1.20.10/24"
        }
      ],
      "services": {
        "http": true
      }
    },
    {
      "id": "PC-B1",
      "type": "pc",
      "model": "PC-PT",
      "zone": "site-b",
      "interfaces": [
        {
          "name": "FastEthernet0",
          "dhcp": true
        }
      ]
    },
    {
      "id": "SRV-B",
      "type": "server",
      "model": "Server-PT",
      "role": "server",
      "zone": "site-b",
      "gateway": "10.2.20.1",
      "interfaces": [
        {
          "name": "FastEthernet0",
          "ip": "10.2.20.10/24"
        }
      ],
      "services": {
        "http": true,
        "dns": {
          "records": [
            {
              "name": "srv-b.lab.local",
              "type": "A",
              "value": "10.2.20.10"
            }
          ]
        }
      }
    }
  ],
  "links": [
    {
      "a": "R-SITE-A:Serial0/0/0",
      "b": "R-SITE-B:Serial0/0/0",
      "medium": "serial",
      "dce": "a",
      "label": "WAN 10.0.0.0/30"
    },
    {
      "a": "R-SITE-A:GigabitEthernet0/0",
      "b": "SW-SITE-A:GigabitEthernet0/1",
      "medium": "copper-straight"
    },
    {
      "a": "R-SITE-B:GigabitEthernet0/0",
      "b": "SW-SITE-B:GigabitEthernet0/1",
      "medium": "copper-straight"
    },
    {
      "a": "PC-A1",
      "b": "SW-SITE-A:FastEthernet0/1",
      "medium": "copper-straight"
    },
    {
      "a": "PC-A2",
      "b": "SW-SITE-A:FastEthernet0/2",
      "medium": "copper-straight"
    },
    {
      "a": "SRV-A",
      "b": "SW-SITE-A:FastEthernet0/13",
      "medium": "copper-straight"
    },
    {
      "a": "PC-B1",
      "b": "SW-SITE-B:FastEthernet0/1",
      "medium": "copper-straight"
    },
    {
      "a": "SRV-B",
      "b": "SW-SITE-B:FastEthernet0/13",
      "medium": "copper-straight"
    }
  ],
  "zones": [
    {
      "id": "site-a",
      "label": "SITE-A",
      "kind": "site",
      "devices": [
        "R-SITE-A",
        "SW-SITE-A",
        "PC-A1",
        "PC-A2",
        "SRV-A"
      ]
    },
    {
      "id": "site-b",
      "label": "SITE-B",
      "kind": "site",
      "devices": [
        "R-SITE-B",
        "SW-SITE-B",
        "PC-B1",
        "SRV-B"
      ]
    }
  ],
  "layout": {
    "algorithm": "hierarchical"
  },
  "tests": [
    {
      "from": "PC-A1",
      "to": "SRV-B",
      "expect": "success",
      "description": "Requirement: SITE-A users reach the SITE-B server (via serial + OSPF)"
    },
    {
      "from": "PC-A1",
      "to": "SRV-A",
      "expect": "success",
      "description": "Inter-VLAN USERS → SERVERS at SITE-A"
    },
    {
      "from": "PC-B1",
      "to": "SRV-B",
      "expect": "success",
      "description": "Inter-VLAN at SITE-B"
    },
    {
      "from": "PC-A2",
      "to": "PC-B1",
      "expect": "success",
      "description": "Users across sites"
    },
    {
      "from": "PC-A1",
      "to": "10.0.0.2",
      "expect": "success",
      "description": "Far end of the serial link"
    },
    {
      "from": "PC-B1",
      "to": "10.1.99.11",
      "expect": "success",
      "description": "SITE-B reaches SW-SITE-A management"
    }
  ]
}
